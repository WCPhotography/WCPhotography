<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WC Photos — Will Carey</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0B0D08;
    --bg-alt: #13160E;
    --surface: #1A1D14;
    --surface-hover: #22261A;
    --text: #F2EFE3;
    --text-dim: #96988A;
    --text-faint: #5C5E52;
    --accent-yellow: #D9CB3B;
    --accent-rust: #C15A34;
    --line: #33352A;
    --line-bright: #4A4C3C;

    --font-display: 'Oswald', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:inherit; text-decoration:none; }
  img{ display:block; width:100%; height:100%; object-fit:cover; }

  ::selection{ background:var(--accent-yellow); color:var(--bg); }

  :focus-visible{
    outline:2px solid var(--accent-yellow);
    outline-offset:3px;
  }

  .wrap{
    max-width:1200px;
    margin:0 auto;
    padding:0 32px;
  }

  /* ---------- NAV ---------- */
  header{
    position:sticky;
    top:0;
    z-index:100;
    background:rgba(11,13,8,0.88);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 32px;
    max-width:1200px;
    margin:0 auto;
  }
  .logo{
    font-family:var(--font-display);
    font-size:20px;
    font-weight:600;
    letter-spacing:0.04em;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .logo .dot{
    width:9px; height:9px;
    border-radius:50%;
    background:var(--accent-yellow);
    box-shadow:0 0 8px rgba(217,203,59,0.6);
  }
  .navlinks{
    display:flex;
    gap:36px;
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--text-dim);
  }
  .navlinks a{ transition:color .2s ease; position:relative; }
  .navlinks a:hover{ color:var(--accent-yellow); }
  .navlinks .frame-count{ color:var(--text-faint); }

  @media (max-width:720px){
    .navlinks{ gap:18px; font-size:10px; }
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:88vh;
    display:flex;
    align-items:flex-end;
    padding:0 0 64px 0;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  .hero-media{
    position:absolute;
    inset:0;
    z-index:0;
  }
  .hero-media img{
    filter:grayscale(20%) contrast(1.05) brightness(0.7);
  }
  .hero-media::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(180deg, rgba(11,13,8,0.15) 0%, rgba(11,13,8,0.55) 60%, rgba(11,13,8,0.96) 100%);
  }
  .hero-frame{
    position:absolute;
    inset:28px;
    z-index:2;
    pointer-events:none;
  }
  .corner{
    position:absolute;
    width:26px; height:26px;
    border:2px solid var(--accent-yellow);
    opacity:0.85;
  }
  .corner.tl{ top:0; left:0; border-right:none; border-bottom:none; }
  .corner.tr{ top:0; right:0; border-left:none; border-bottom:none; }
  .corner.bl{ bottom:0; left:0; border-right:none; border-top:none; }
  .corner.br{ bottom:0; right:0; border-left:none; border-top:none; }

  .hero-exif{
    position:absolute;
    top:28px; right:28px;
    z-index:2;
    font-family:var(--font-mono);
    font-size:11px;
    color:var(--accent-yellow);
    text-align:right;
    letter-spacing:0.03em;
    line-height:1.7;
    text-transform:uppercase;
  }
  .hero-exif span{ color:var(--text-faint); }

  .hero-content{
    position:relative;
    z-index:2;
    max-width:1200px;
    margin:0 auto;
    padding:0 32px;
    width:100%;
  }
  .hero-eyebrow{
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--accent-yellow);
    margin-bottom:18px;
  }
  .hero h1{
    font-family:var(--font-display);
    font-weight:700;
    font-size:clamp(44px, 8vw, 96px);
    line-height:0.96;
    letter-spacing:-0.01em;
    text-transform:uppercase;
    max-width:820px;
  }
  .hero p{
    margin-top:22px;
    max-width:520px;
    color:var(--text-dim);
    font-size:16px;
  }
  .hero-cta{
    margin-top:32px;
    display:flex;
    gap:14px;
    flex-wrap:wrap;
  }
  .btn{
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    padding:13px 22px;
    border:1px solid var(--line-bright);
    transition:all .2s ease;
  }
  .btn.primary{
    background:var(--accent-yellow);
    color:var(--bg);
    border-color:var(--accent-yellow);
    font-weight:600;
  }
  .btn.primary:hover{ background:#eadf5e; }
  .btn.ghost:hover{ border-color:var(--accent-yellow); color:var(--accent-yellow); }

  /* ---------- SECTION SCAFFOLD ---------- */
  section.gallery-section{
    padding:96px 0;
    border-bottom:1px solid var(--line);
  }
  section.gallery-section:nth-of-type(even){ background:var(--bg-alt); }

  .section-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    margin-bottom:44px;
    gap:24px;
    flex-wrap:wrap;
  }
  .section-eyebrow{
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--accent-yellow);
    margin-bottom:10px;
  }
  .section-head h2{
    font-family:var(--font-display);
    font-size:clamp(30px, 4vw, 46px);
    text-transform:uppercase;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  .section-note{
    max-width:340px;
    color:var(--text-dim);
    font-size:14px;
    text-align:right;
  }
  @media (max-width:720px){
    .section-note{ text-align:left; max-width:100%; }
  }

  /* ---------- GALLERY GRID ---------- */
  .grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:3px;
  }
  .grid.wide{ grid-template-columns:repeat(4, 1fr); }
  @media (max-width:900px){
    .grid, .grid.wide{ grid-template-columns:repeat(2, 1fr); }
  }
  @media (max-width:520px){
    .grid, .grid.wide{ grid-template-columns:1fr; }
  }

  .frame{
    position:relative;
    aspect-ratio:4/5;
    overflow:hidden;
    background:var(--surface);
    cursor:pointer;
  }
  .frame img{
    transition:transform .5s ease, filter .5s ease;
    filter:grayscale(35%) contrast(1.02);
  }
  .frame:hover img{
    transform:scale(1.045);
    filter:grayscale(0%) contrast(1.05);
  }
  .af-corner{
    position:absolute;
    width:18px; height:18px;
    border:1.5px solid var(--accent-yellow);
    opacity:0;
    transition:opacity .25s ease;
  }
  .frame:hover .af-corner{ opacity:1; }
  .af-corner.tl{ top:10px; left:10px; border-right:none; border-bottom:none; }
  .af-corner.tr{ top:10px; right:10px; border-left:none; border-bottom:none; }
  .af-corner.bl{ bottom:10px; left:10px; border-right:none; border-top:none; }
  .af-corner.br{ bottom:10px; right:10px; border-left:none; border-top:none; }

  .frame-caption{
    position:absolute;
    left:0; right:0; bottom:0;
    padding:10px 12px;
    background:linear-gradient(0deg, rgba(11,13,8,0.92), transparent);
    transform:translateY(100%);
    transition:transform .3s ease;
  }
  .frame:hover .frame-caption{ transform:translateY(0); }
  .frame-caption .cap-title{
    font-family:var(--font-body);
    font-size:13px;
    font-weight:500;
    color:var(--text);
  }
  .frame-caption .cap-exif{
    font-family:var(--font-mono);
    font-size:10px;
    color:var(--accent-yellow);
    letter-spacing:0.04em;
    margin-top:2px;
    text-transform:uppercase;
  }

  /* ---------- ABOUT ---------- */
  .about{
    padding:80px 0;
    border-bottom:1px solid var(--line);
  }
  .about-grid{
    display:grid;
    grid-template-columns:1fr 1.4fr;
    gap:56px;
    align-items:start;
  }
  @media (max-width:800px){
    .about-grid{ grid-template-columns:1fr; }
  }
  .about-label{
    font-family:var(--font-mono);
    font-size:12px;
    color:var(--accent-yellow);
    text-transform:uppercase;
    letter-spacing:0.1em;
  }
  .about h3{
    font-family:var(--font-display);
    font-size:clamp(26px,3.4vw,38px);
    text-transform:uppercase;
    margin-top:10px;
    line-height:1.15;
  }
  .about-body p{
    color:var(--text-dim);
    font-size:16px;
    margin-bottom:16px;
    max-width:560px;
  }
  .about-body strong{ color:var(--text); font-weight:600; }

  /* ---------- CONTACT / FOOTER ---------- */
  footer{
    padding:80px 0 40px;
  }
  .contact-grid{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:32px;
    padding-bottom:48px;
    border-bottom:1px solid var(--line);
  }
  footer h2{
    font-family:var(--font-display);
    font-size:clamp(32px,5vw,56px);
    text-transform:uppercase;
    max-width:560px;
    line-height:1.05;
  }
  .contact-links{
    display:flex;
    flex-direction:column;
    gap:10px;
    font-family:var(--font-mono);
    font-size:14px;
  }
  .contact-links a{
    color:var(--text-dim);
    transition:color .2s ease;
  }
  .contact-links a:hover{ color:var(--accent-yellow); }

  .footer-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding-top:24px;
    font-family:var(--font-mono);
    font-size:11px;
    color:var(--text-faint);
    letter-spacing:0.04em;
    flex-wrap:wrap;
    gap:10px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ transition:none !important; scroll-behavior:auto !important; }
  }
</style>
</head>
<body>

<header>
  <nav>
    <div class="logo"><span class="dot"></span>WC PHOTOS</div>
    <div class="navlinks">
      <a href="#tennis">Tennis</a>
      <a href="#automotive">Automotive</a>
      <a href="#wildlife">Beyond the Court</a>
      <a href="#contact">Contact</a>
      <span class="frame-count">Est. State College, PA</span>
